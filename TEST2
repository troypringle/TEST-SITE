<script>
    // --- HUMMINGBIRD FLIGHT LOGIC ---
    const bird = document.getElementById('hummingbird-container');
    let mouseX = 0, mouseY = 0;
    let birdX = 0, birdY = 0;

    document.addEventListener('mousemove', (e) => {
        mouseX = e.clientX;
        mouseY = e.clientY;
    });

    function animateBird() {
        // Follow mouse with a slight delay (easing)
        birdX += (mouseX - birdX - 60) * 0.05;
        birdY += (mouseY - birdY - 60) * 0.05;
        
        // Add a "hover" wobble
        const hoverX = Math.sin(Date.now() / 200) * 10;
        const hoverY = Math.cos(Date.now() / 150) * 10;

        bird.style.transform = `translate(${birdX + hoverX}px, ${birdY + hoverY}px) scaleX(${mouseX > birdX + 60 ? 1 : -1})`;
        requestAnimationFrame(animateBird);
    }
    animateBird();

    // --- WING NOISE ENGINE ---
    let audioCtx;
    let oscillator;
    let gainNode;

    function startHum() {
        if (audioCtx) return; // Already started

        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        oscillator = audioCtx.createOscillator();
        gainNode = audioCtx.createGain();

        // Low frequency hum + "buzz" harmonics
        oscillator.type = 'triangle'; 
        oscillator.frequency.setValueAtTime(60, audioCtx.currentTime); // Base hum frequency

        // Volume control
        gainNode.gain.setValueAtTime(0.02, audioCtx.currentTime); // Keep it subtle

        oscillator.connect(gainNode);
        gainNode.connect(audioCtx.destination);
        oscillator.start();
    }

    // Start sound on first click
    document.addEventListener('mousedown', startHum);

    // --- PREVIOUS URL PARAM LOGIC ---
    (function() {
        var params = window.location.search;
        if (params) {
            var links = document.getElementsByTagName('a');
            for (var i = 0; i < links.length; i++) {
                if(links[i].href.indexOf('troysmartai') !== -1) {
                    var sep = links[i].href.indexOf('?') !== -1 ? '&' : '?';
                    links[i].href += sep + params.substring(1);
                }
            }
        }
    })();
</script>

